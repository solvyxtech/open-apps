---
/**
 * Stacks index — every stack with live counts. Linked from the
 * default header nav; each tile opens the browse page pre-filtered to
 * the stack (detail pages live at `/stacks/<id>/`).
 */
import siteConfig from '@grove/generated/site-config.json';
import {
  getTaxonomyIndexModel,
  getTaxonomyIndexSeo,
  itemLabel,
  itemLabelPlural,
  seoTitle,
} from '@grove-dev/astro/server';
import StackGrid from '../../components/grove/stack-grid.astro';
import BaseLayout from '../../layouts/base-layout.astro';

const slug = siteConfig.blueprintConfig?.routeSlug ?? 'projects';
// Uncapped: the index page lists EVERY stack (the homepage grid's
// 12-item cap is a homepage layout choice, not a data truth).
const { stacks } = getTaxonomyIndexModel();
const itemNoun = { singular: itemLabel(), plural: itemLabelPlural() };
const seo = getTaxonomyIndexSeo('stacks', siteConfig);
const title = seoTitle('Open Source Apps by Stack', siteConfig.name);
const description =
  'Browse open-source apps by the stack they are built with — Flutter, React Native, native iOS, Tauri, React and more. Codebases you can run and study.';
---

<BaseLayout
  title={title}
  description={description}
  image={seo.image}
  jsonLd={seo.jsonLd}
  site={siteConfig}
>
  <StackGrid
    stacks={stacks}
    pathPrefix={`/${slug}`}
    itemLabelPlural={itemLabelPlural()}
    itemNoun={itemNoun}
    level={1}
    heading="Open source apps by stack"
    lede="Pick a stack to see real, production apps built with it — with source code you can run and study."
    hrefFor={(stackSlug: string) => `/stacks/${stackSlug}/`}
  />
</BaseLayout>
